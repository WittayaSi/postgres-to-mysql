graph TB
    subgraph Frontend["Frontend (Browser)"]
        UI["Web UI\nindex.html + app.js"]
        WS["Socket.IO Client"]
    end

    subgraph Backend["Backend (Node.js/Express)"]
        SRV["server.ts\nExpress + Socket.IO"]
        API["routes.ts\nREST API"]
        SCH["jobScheduler.ts\nCron Jobs"]
        TE["transferEngine.ts\nTransfer Logic"]
        TC["tableClassifier.ts\nTable Classification"]
        CFG["config/index.ts\nConfiguration"]
        LOG["logger.ts\nWinston Logger"]
    end

    subgraph DB["Databases"]
        PG[("PostgreSQL\n(Source - READ ONLY)")]
        MY[("MySQL\n(Destination - WRITE)")]
    end

    UI -->|HTTP API| API
    UI -->|WebSocket| WS
    WS <-->|Real-time Status| SRV
    API --> TE
    API --> TC
    API --> SCH
    SCH -->|Cron Trigger| TE
    TE --> TC
    TE -->|Read Data| PG
    TE -->|Write Data| MY
    TC -->|Schema Info| PG
    TC -->|Auto-create Tables| MY
    CFG -->|Config| SCH
    CFG -->|Config| TE
    LOG -->|File + Console| SRV

    style Frontend fill:#1e3a5f,stroke:#3b82f6,color:#fff
    style Backend fill:#1e1b4b,stroke:#6366f1,color:#fff
    style DB fill:#14532d,stroke:#22c55e,color:#fff
    style PG fill:#2563eb,stroke:#93c5fd,color:#fff
    style MY fill:#d97706,stroke:#fcd34d,color:#fff
