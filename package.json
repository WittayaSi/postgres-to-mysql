{
  "name": "postgres-to-mysql",
  "version": "1.0.0",
  "description": "PostgreSQL to MySQL data transfer system with Web UI",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node server.ts",
    "dev:watch": "nodemon --exec ts-node server.ts",
    "css:build": "npx tailwindcss -i ./public/css/styles.css -o ./public/css/output.css",
    "css:watch": "npx tailwindcss -i ./public/css/styles.css -o ./public/css/output.css --watch"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "cron-parser": "^5.4.0",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mysql2": "^3.6.0",
    "node-cron": "^3.0.3",
    "p-limit": "^7.3.0",
    "pg": "^8.11.0",
    "socket.io": "^4.7.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "autoprefixer": "^10.4.23",
    "nodemon": "^3.0.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^2.2.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
